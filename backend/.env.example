# 数据库：默认 SQLite（相对 backend/ 目录），MySQL 可选
# DATABASE_URL=sqlite:///./glassmeter.db
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/glassmeter?charset=utf8mb4

# 生产必须修改
JWT_SECRET=change-me-in-production

# 允许的前端来源，逗号分隔（/api/collect 始终放开 *）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 埋点 SDK 文件位置（相对仓库根，默认 ../tracker/tracker.js）
# TRACKER_PATH=../tracker/tracker.js

# 统计用固定时区偏移（小时）
TZ_OFFSET=8

# 是否由后端托管前端构建产物（frontend/dist 存在时生效）
SERVE_FRONTEND=false